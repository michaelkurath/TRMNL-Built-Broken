{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign filter_mode = settings.content_filter | default: "both" | downcase %}
{% assign display_mode = settings.display_mode | default: "daily" | downcase %}
{% assign pool = events %}
{% if filter_mode contains "breakthrough" %}{% assign pool = events | where: "type", "breakthrough" %}{% endif %}
{% if filter_mode contains "failure" %}{% assign pool = events | where: "type", "failure" %}{% endif %}
{% if pool == empty %}{% assign pool = events %}{% endif %}
{% assign local_timestamp = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign today_key = local_timestamp | date: "%m-%d" %}
{% assign day_index = local_timestamp | date: "%j" | plus: 0 | minus: 1 | modulo: pool.size %}
{% assign selected = pool[day_index] %}
{% assign anniversary = false %}
{% if display_mode contains "random" %}
  {% assign random_index = "now" | date: "%N" | modulo: pool.size %}
  {% assign selected = pool[random_index] %}
{% else %}
  {% for item in pool %}{% if item.month_day == today_key %}{% assign selected = item %}{% assign anniversary = true %}{% break %}{% endif %}{% endfor %}
{% endif %}
{% assign show_summary = true %}{% if settings.show_summary == false or settings.show_summary == "false" %}{% assign show_summary = false %}{% endif %}
{% assign show_source = false %}{% if settings.show_source == true or settings.show_source == "true" %}{% assign show_source = true %}{% endif %}

<div class="layout layout--col layout--stretch">
  <div class="flex flex--col gap--small stretch">
    <div class="flex flex--row flex--between flex--center-y gap--small">
      <span class="label {% if selected.type == 'failure' %}label--inverted{% else %}label--outline{% endif %}">{{ selected.type | upcase }}</span>
      <span class="bb-case-note label">{% if display_mode contains "random" %}Random case{% elsif anniversary %}On this day · {{ today_key | replace: "-", "." }}{% else %}Curated case{% endif %}</span>
    </div>
    <div class="bb-main grid gap--medium stretch">
      <div class="bb-story flex flex--col flex--between gap--small pt--small">
        <div class="flex flex--col gap--small">
          <div class="flex flex--row flex--between flex--bottom gap--small">
            <div class="bb-year text--tera font--bold">{{ selected.year }}</div>
            <div class="bb-discipline label text--right pb--small">{{ selected.discipline }}<br>engineering</div>
          </div>
          <div class="bb-headline title title--xxlarge">{{ selected.title }}</div>
        </div>
        {% if show_summary %}
          <div class="flex flex--col gap--small pt--small">
            <div class="divider"></div>
            <span class="label text--center">What happened</span>
            <div class="bb-summary description text--large">{{ selected.summary }}</div>
          </div>
        {% endif %}
      </div>
      <div class="bb-lesson flex flex--col gap--small p--medium">
        <div class="flex flex--row flex--between flex--center-y gap--small pb--small">
          <span class="label">Engineering lesson</span>
          <span class="bb-lesson-mark flex flex--row flex--center label w--8 h--8 {% if selected.type == 'failure' %}label--inverted{% endif %}">{% if selected.type == 'failure' %}!{% else %}+{% endif %}</span>
        </div>
        <div class="divider"></div>
        <div class="bb-lesson-body flex flex--row flex--center-y"><div class="bb-lesson-text text--xlarge font--bold">{{ selected.lesson }}</div></div>
        {% if show_source %}
          <div class="bb-source-row pt--small">
            <div class="bb-source description text--small">Source: {{ selected.source_label }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar"><span class="title">Built &amp; Broken</span><span class="instance">{{ selected.year }} · {{ selected.discipline }}</span></div>
