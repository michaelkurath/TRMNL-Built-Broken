{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign filter_mode = settings.content_filter | default: "both" | downcase %}
{% assign display_mode = settings.display_mode | default: "daily" | downcase %}
{% if events == nil or events == empty %}
<div class="layout layout--col layout--center text--center"><span class="description">No engineering cases received.</span></div>
<div class="title_bar"><span class="title">Built &amp; Broken</span><span class="instance">Data unavailable</span></div>
{% else %}
{% assign pool = events %}
{% if filter_mode == "breakthrough" %}{% assign pool = events | where: "type", "breakthrough" %}{% endif %}
{% if filter_mode == "failure" %}{% assign pool = events | where: "type", "failure" %}{% endif %}
{% assign filter_fallback = false %}
{% if pool == empty %}{% assign filter_fallback = true %}{% assign pool = events %}{% endif %}
{% assign local_timestamp = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign today_key = local_timestamp | date: "%m-%d" %}
{% assign day_index = local_timestamp | date: "%j" | plus: 0 | minus: 1 | modulo: pool.size %}
{% assign selected = pool[day_index] %}
{% if display_mode == "random" %}
  {% assign max_index = pool.size | minus: 1 %}
  {% assign random_index = "" | random_number: max_index | plus: 0 %}
  {% assign selected = pool[random_index] %}
{% else %}
  {% for item in pool %}{% if item.month_day == today_key %}{% assign selected = item %}{% break %}{% endif %}{% endfor %}
{% endif %}
<div class="layout layout--col layout--stretch">
  <div class="flex flex--col flex--center-y gap--small h--full">
    <div class="flex flex--row flex--between flex--center-y gap--small">
      <span class="label {% if selected.type == 'failure' %}label--inverted{% else %}label--outline{% endif %}">{{ selected.type | default: "case" | upcase }}</span>
      <span class="label label--outline">{% if filter_fallback %}ALL · {% endif %}{{ selected.year | default: "----" }}{% if display_mode == "random" %} · RANDOM{% endif %}</span>
    </div>
    <div class="title title--small md:title--base portrait:title--small">{{ selected.title | default: "Engineering case" }}</div>
    <div class="divider"></div>
    <div class="description text--small md:text--base portrait:text--small font--bold">{{ selected.lesson | default: "No engineering lesson is available." }}</div>
  </div>
</div>

<div class="title_bar"><span class="title">Built &amp; Broken</span><span class="instance">{{ selected.discipline | default: "General" }}</span></div>
{% endif %}
