{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign filter_mode = settings.content_filter | default: "both" | downcase %}
{% assign pool = events %}
{% if filter_mode contains "breakthrough" %}{% assign pool = events | where: "type", "breakthrough" %}{% endif %}
{% if filter_mode contains "failure" %}{% assign pool = events | where: "type", "failure" %}{% endif %}
{% if pool == empty %}{% assign pool = events %}{% endif %}
{% assign local_timestamp = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign today_key = local_timestamp | date: "%m-%d" %}
{% assign day_index = local_timestamp | date: "%j" | plus: 0 | minus: 1 | modulo: pool.size %}
{% assign selected = pool[day_index] %}
{% assign anniversary = false %}
{% for item in pool %}{% if item.month_day == today_key %}{% assign selected = item %}{% assign anniversary = true %}{% break %}{% endif %}{% endfor %}
{% assign show_source_qr = true %}{% if settings.show_source_qr == false or settings.show_source_qr == "false" %}{% assign show_source_qr = false %}{% endif %}

<div class="layout layout--col layout--stretch">
  <div class="bb-compact">
    <div class="bb-meta">
      <span class="label {% if selected.type == 'failure' %}label--inverted{% else %}label--outline{% endif %}">{{ selected.type | upcase }}</span>
      <span class="label label--outline">{{ selected.discipline | upcase }} · {{ selected.year }}{% if anniversary %} · TODAY{% endif %}</span>
    </div>
    <div class="bb-headline">{{ selected.title }}</div>
    <div class="bb-rule"></div>
    <div class="bb-lesson-row">
      <div class="bb-lesson-text">{{ selected.lesson }}</div>
      {% if show_source_qr and selected.source_url %}<div class="bb-compact-qr">{{ selected.source_url | qr_code: 2 }}</div>{% endif %}
    </div>
  </div>
</div>

<div class="title_bar"><span class="title">Built &amp; Broken</span><span class="instance">Engineering lesson</span></div>
